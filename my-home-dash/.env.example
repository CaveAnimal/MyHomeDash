# ─────────────────────────────────────────────
#  MY HOME DASH — Environment Variables Template
#  Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# ── WEATHER ──────────────────────────────────
# https://openweathermap.org/api → free tier key
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# https://www.weatherapi.com → free tier key
WEATHERAPI_KEY=your_weatherapi_key_here

# ── GITHUB ───────────────────────────────────
# GitHub → Settings → Developer Settings → Personal Access Tokens → Fine-grained
# Required scopes: repo (read), notifications
GITHUB_PAT=your_github_personal_access_token

# Optional: override the github username (defaults to authenticated user)
GITHUB_USERNAME=

# ── CALENDAR — ICS FEED (no Azure app registration needed) ──────────────────
# Simplest calendar source: publish your Outlook/Exchange calendar to a read-only
# ICS link (Outlook Web → Settings → Calendar → Shared calendars → Publish a calendar)
# and paste the resulting URL here. If this is set, calendar_mod.py uses it instead
# of the Microsoft Graph path below. Treat this URL as a secret — anyone with it can
# read your calendar.
CALENDAR_ICS_URL=

# ── MICROSOFT — WORK ACCOUNT (Outlook + Calendar) ────────────────────────────
# Only needed if you are NOT using CALENDAR_ICS_URL above.
# Register an app in your work Azure Portal (portal.azure.com)
# App type: Public client, redirect URI: http://localhost
# API permissions: Calendars.Read, Mail.Read, offline_access
MICROSOFT_WORK_CLIENT_ID=your_work_azure_app_client_id
MICROSOFT_WORK_TENANT_ID=your_work_tenant_id_or_organizations

# ── MICROSOFT — HOME ACCOUNT (Personal Outlook.com email) ────────────────────
# Register an app at https://portal.azure.com using a personal Microsoft account
# App type: Public client, accounts: "Personal Microsoft accounts only"
# API permissions: Mail.Read, offline_access
MICROSOFT_HOME_CLIENT_ID=your_home_azure_app_client_id

# ── MICROSOFT — TEAMS ACCOUNT (different Microsoft account) ──────────────────
# Register an app in the Azure Portal for the Teams tenant
# App type: Public client, redirect URI: http://localhost
# API permissions: Chat.Read, ChannelMessage.Read.All, offline_access
MICROSOFT_TEAMS_CLIENT_ID=your_teams_azure_app_client_id
MICROSOFT_TEAMS_TENANT_ID=your_teams_tenant_id_or_organizations

# ── GMAIL — APP PASSWORD + IMAP (no Google Cloud project needed) ────────────
# Recommended low-maintenance path: myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled) → generate an app password → paste below.
# If both ADDRESS and APP_PASSWORD are set for an account, email_mod.py uses IMAP
# instead of the OAuth path below. Treat app passwords as secrets.
GMAIL_1_ADDRESS=
GMAIL_1_APP_PASSWORD=
GMAIL_2_ADDRESS=
GMAIL_2_APP_PASSWORD=

# ── GOOGLE — GMAIL OAUTH (fallback; only needed if not using App Passwords) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Application type: Desktop app
# Download JSON and extract the client_id and client_secret
# Scopes needed: https://www.googleapis.com/auth/gmail.readonly
# Note: personal/"Testing" OAuth apps get refresh tokens that expire every 7 days,
# forcing re-auth weekly. App Passwords above avoid that entirely.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── TYPESAFE JEV — email triage (optional) ───────────────────────────────────
# Only needed if email.jev_classification.enabled is true in config.yaml.
# Get a key at https://typesafe.ai — classifies each unread subject into a
# category (urgent/action_needed/informational/low_priority by default).
TYPESAFE_API_KEY=
